# Application Settings
APP_NAME="Automated Multi-Platform Posting System"
APP_ENV=development
REQUEST_TIMEOUT=15.0

# 1. GitHub Gist API (Personal Access Token dengan scope 'gist')
GITHUB_GIST_TOKEN=ghp_your_github_personal_access_token

# 2. Dev.to (Forem) API Key
DEVTO_API_KEY=your_devto_api_key

# 3. Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHANNEL_ID=@your_public_channel

# 4. Discord Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_GUILD_ID=your_server_guild_id

# 5. Mastodon API
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token